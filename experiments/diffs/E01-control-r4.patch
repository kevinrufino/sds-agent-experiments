diff --git a/src/examples/TeamSettings.tsx b/src/examples/TeamSettings.tsx
new file mode 100644
index 0000000..2766bb1
--- /dev/null
+++ b/src/examples/TeamSettings.tsx
@@ -0,0 +1,234 @@
+import { useMediaQuery } from "hooks";
+import { IconAlertCircle, IconCheckCircle, IconTrash } from "icons";
+import { Flex, Section } from "layout";
+import {
+  Avatar,
+  AvatarBlock,
+  Button,
+  ButtonGroup,
+  DestructiveIconButton,
+  Form,
+  InputField,
+  Notification,
+  SelectField,
+  SelectItem,
+  SwitchField,
+  SwitchGroup,
+  TextHeading,
+  TextSubtitle,
+  TextTitlePage,
+} from "primitives";
+import { useState } from "react";
+import "./teamSettings.css";
+
+type Role = "Owner" | "Admin" | "Editor" | "Viewer";
+type Member = { id: string; name: string; email: string; role: Role };
+type Settings = {
+  name: string;
+  email: string;
+  jobTitle: string;
+  productUpdates: boolean;
+  weeklyDigest: boolean;
+  members: Member[];
+};
+
+const ROLES: Role[] = ["Owner", "Admin", "Editor", "Viewer"];
+
+const INITIAL: Settings = {
+  name: "Alex Morgan",
+  email: "alex.morgan@example.com",
+  jobTitle: "Product Designer",
+  productUpdates: true,
+  weeklyDigest: false,
+  members: [
+    { id: "1", name: "Alex Morgan", email: "alex.morgan@example.com", role: "Owner" },
+    { id: "2", name: "Priya Shah", email: "priya.shah@example.com", role: "Admin" },
+    { id: "3", name: "Jordan Lee", email: "jordan.lee@example.com", role: "Editor" },
+    { id: "4", name: "Sam Rivera", email: "sam.rivera@example.com", role: "Viewer" },
+  ],
+};
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const initials = (name: string) =>
+  name.split(" ").map((part) => part[0]).join("").slice(0, 2).toUpperCase();
+
+export function TeamSettings() {
+  const { isMobile } = useMediaQuery();
+  const [saved, setSaved] = useState<Settings>(INITIAL);
+  const [values, setValues] = useState<Settings>(INITIAL);
+  const [showSaved, setShowSaved] = useState(false);
+
+  const update = (patch: Partial<Settings>) => {
+    setValues((current) => ({ ...current, ...patch }));
+    setShowSaved(false);
+  };
+  const updateMember = (id: string, role: Role) =>
+    update({ members: values.members.map((m) => (m.id === id ? { ...m, role } : m)) });
+  const removeMember = (id: string) =>
+    update({ members: values.members.filter((m) => m.id !== id) });
+
+  const nameError = values.name.trim() ? undefined : "Enter your full name.";
+  const emailError = EMAIL_PATTERN.test(values.email.trim())
+    ? undefined
+    : "Enter a valid email address, like name@example.com.";
+  const isInvalid = Boolean(nameError || emailError);
+  const isDirty = JSON.stringify(values) !== JSON.stringify(saved);
+
+  const save = () => {
+    if (isInvalid || !isDirty) return;
+    setSaved(values);
+    setShowSaved(true);
+  };
+  const cancel = () => {
+    setValues(saved);
+    setShowSaved(false);
+  };
+
+  return (
+    <Section padding={isMobile ? "600" : "1600"} aria-labelledby="team-settings-title">
+      <Flex container direction="column" alignSecondary="stretch" gap="800">
+        <Flex direction="column" gap="200">
+          <TextTitlePage elementType="h1" id="team-settings-title">
+            Team settings
+          </TextTitlePage>
+          <TextSubtitle>Manage your profile, notifications and who has access to your team.</TextSubtitle>
+        </Flex>
+
+        <Form
+          validationBehavior="aria"
+          onSubmit={(event) => {
+            event.preventDefault();
+            save();
+          }}
+        >
+          <Flex direction="column" alignSecondary="stretch" gap="800">
+            {isInvalid && (
+              <Notification variant="alert" role="alert" icon={<IconAlertCircle />}>
+                Some fields need your attention before you can save.
+              </Notification>
+            )}
+            {showSaved && (
+              <Notification role="status" icon={<IconCheckCircle />}>
+                Your changes have been saved.
+              </Notification>
+            )}
+
+            <section aria-labelledby="profile-heading">
+              <Flex direction="column" alignSecondary="stretch" gap="400">
+                <TextHeading elementType="h2" id="profile-heading">Profile</TextHeading>
+                <InputField
+                  label="Full name"
+                  isRequired
+                  value={values.name}
+                  onChange={(name) => update({ name })}
+                  isInvalid={Boolean(nameError)}
+                  errorMessage={nameError}
+                  autoComplete="name"
+                />
+                <InputField
+                  label="Email"
+                  type="email"
+                  isRequired
+                  value={values.email}
+                  onChange={(email) => update({ email })}
+                  isInvalid={Boolean(emailError)}
+                  errorMessage={emailError}
+                  autoComplete="email"
+                />
+                <InputField
+                  label="Job title"
+                  description="Shown to teammates next to your name."
+                  value={values.jobTitle}
+                  onChange={(jobTitle) => update({ jobTitle })}
+                  autoComplete="organization-title"
+                />
+              </Flex>
+            </section>
+
+            <section aria-labelledby="notifications-heading">
+              <Flex direction="column" alignSecondary="stretch" gap="400">
+                <TextHeading elementType="h2" id="notifications-heading">Notifications</TextHeading>
+                <SwitchGroup>
+                  <SwitchField
+                    label="Product updates"
+                    description="News about new features and improvements."
+                    isSelected={values.productUpdates}
+                    onChange={(productUpdates) => update({ productUpdates })}
+                  />
+                  <SwitchField
+                    label="Weekly digest"
+                    description="A summary of your team's activity every Monday."
+                    isSelected={values.weeklyDigest}
+                    onChange={(weeklyDigest) => update({ weeklyDigest })}
+                  />
+                  <SwitchField
+                    label="Security alerts"
+                    description="Always on to keep your account safe."
+                    isSelected
+                    isDisabled
+                  />
+                </SwitchGroup>
+              </Flex>
+            </section>
+
+            <section aria-labelledby="members-heading">
+              <Flex direction="column" alignSecondary="stretch" gap="400">
+                <TextHeading elementType="h2" id="members-heading">Team members</TextHeading>
+                <ul className="team-settings-members">
+                  {values.members.map((member) => {
+                    const isOwner = member.role === "Owner";
+                    return (
+                      <li key={member.id} className="team-settings-member">
+                        <Flex
+                          direction={isMobile ? "column" : "row"}
+                          alignPrimary="space-between"
+                          alignSecondary={isMobile ? "stretch" : "center"}
+                          gap="400"
+                        >
+                          <AvatarBlock title={member.name} description={member.email}>
+                            <Avatar initials={initials(member.name)} />
+                          </AvatarBlock>
+                          <Flex alignSecondary="center" gap="200">
+                            <SelectField
+                              aria-label={`Role for ${member.name}`}
+                              className="team-settings-role"
+                              selectedKey={member.role}
+                              onSelectionChange={(key) => updateMember(member.id, key as Role)}
+                              disabledKeys={["Owner"]}
+                              isDisabled={isOwner}
+                            >
+                              {ROLES.map((role) => (
+                                <SelectItem key={role} id={role}>{role}</SelectItem>
+                              ))}
+                            </SelectField>
+                            <DestructiveIconButton
+                              variant="danger-subtle"
+                              aria-label={isOwner ? `${member.name} is the owner and cannot be removed` : `Remove ${member.name}`}
+                              isDisabled={isOwner}
+                              onPress={() => removeMember(member.id)}
+                            >
+                              <IconTrash />
+                            </DestructiveIconButton>
+                          </Flex>
+                        </Flex>
+                      </li>
+                    );
+                  })}
+                </ul>
+              </Flex>
+            </section>
+
+            <ButtonGroup align={isMobile ? "stack" : "end"}>
+              <Button variant="neutral" type="button" onPress={cancel} isDisabled={!isDirty}>
+                Cancel
+              </Button>
+              <Button variant="primary" type="submit" isDisabled={!isDirty || isInvalid}>
+                Save changes
+              </Button>
+            </ButtonGroup>
+          </Flex>
+        </Form>
+      </Flex>
+    </Section>
+  );
+}
