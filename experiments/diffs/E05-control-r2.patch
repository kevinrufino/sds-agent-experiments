diff --git a/src/examples/TeamSettings.tsx b/src/examples/TeamSettings.tsx
new file mode 100644
index 0000000..d3a6dda
--- /dev/null
+++ b/src/examples/TeamSettings.tsx
@@ -0,0 +1,226 @@
+import { useMediaQuery } from "hooks";
+import { Flex, FlexItem, Section } from "layout";
+import {
+  Avatar,
+  AvatarBlock,
+  Button,
+  ButtonDanger,
+  ButtonGroup,
+  Form,
+  InputField,
+  Notification,
+  SelectField,
+  SelectItem,
+  SwitchField,
+  SwitchGroup,
+  TextHeading,
+  TextSubtitle,
+  TextTitlePage,
+} from "primitives";
+import { FormEvent, useState } from "react";
+
+const ROLES = ["Owner", "Admin", "Editor", "Viewer"] as const;
+type Role = (typeof ROLES)[number];
+type Member = { id: string; name: string; email: string; role: Role };
+
+type Settings = {
+  name: string;
+  email: string;
+  jobTitle: string;
+  productUpdates: boolean;
+  weeklyDigest: boolean;
+  members: Member[];
+};
+
+const INITIAL: Settings = {
+  name: "Avery Johnson",
+  email: "avery@example.com",
+  jobTitle: "Product designer",
+  productUpdates: true,
+  weeklyDigest: false,
+  members: [
+    { id: "1", name: "Avery Johnson", email: "avery@example.com", role: "Owner" },
+    { id: "2", name: "Jordan Lee", email: "jordan@example.com", role: "Admin" },
+    { id: "3", name: "Sam Rivera", email: "sam@example.com", role: "Editor" },
+    { id: "4", name: "Taylor Kim", email: "taylor@example.com", role: "Viewer" },
+  ],
+};
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const initials = (name: string) =>
+  name.split(" ").map((part) => part.charAt(0)).join("").slice(0, 2);
+
+export function TeamSettings() {
+  const { isMobile } = useMediaQuery();
+  const [saved, setSaved] = useState<Settings>(INITIAL);
+  const [values, setValues] = useState<Settings>(INITIAL);
+  const [justSaved, setJustSaved] = useState(false);
+
+  const update = (patch: Partial<Settings>) => {
+    setValues((current) => ({ ...current, ...patch }));
+    setJustSaved(false);
+  };
+  const updateMember = (id: string, role: Role) =>
+    update({ members: values.members.map((m) => (m.id === id ? { ...m, role } : m)) });
+  const removeMember = (id: string) =>
+    update({ members: values.members.filter((m) => m.id !== id) });
+
+  const nameError = values.name.trim() ? undefined : "Enter your full name.";
+  const emailError = EMAIL_PATTERN.test(values.email.trim())
+    ? undefined
+    : "Enter a valid email address, like name@example.com.";
+  const isInvalid = Boolean(nameError || emailError);
+  const isDirty = JSON.stringify(values) !== JSON.stringify(saved);
+
+  const onSubmit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (!isDirty || isInvalid) return;
+    setSaved(values);
+    setJustSaved(true);
+  };
+  const onCancel = () => {
+    setValues(saved);
+    setJustSaved(false);
+  };
+
+  return (
+    <Section padding={isMobile ? "600" : "1600"} aria-labelledby="team-settings-title">
+      <Flex container direction="column" gap={isMobile ? "600" : "800"}>
+        <Flex direction="column" gap="200">
+          <TextTitlePage elementType="h1" id="team-settings-title">
+            Team settings
+          </TextTitlePage>
+          <TextSubtitle>Manage your profile, notifications and who has access to your team.</TextSubtitle>
+        </Flex>
+
+        <Form onSubmit={onSubmit} validationBehavior="aria">
+          <Flex direction="column" gap={isMobile ? "600" : "800"}>
+            <div aria-live="polite">
+              {isInvalid && (
+                <Notification variant="alert" role="alert">
+                  Please fix the highlighted fields before saving.
+                </Notification>
+              )}
+              {justSaved && !isDirty && (
+                <Notification role="status">Your changes have been saved.</Notification>
+              )}
+            </div>
+
+            <Flex direction="column" gap="400">
+              <TextHeading elementType="h2">Profile</TextHeading>
+              <InputField
+                label="Full name"
+                value={values.name}
+                onChange={(name) => update({ name })}
+                isRequired
+                isInvalid={Boolean(nameError)}
+                errorMessage={nameError}
+                autoComplete="name"
+              />
+              <InputField
+                label="Email"
+                type="email"
+                value={values.email}
+                onChange={(email) => update({ email })}
+                isRequired
+                isInvalid={Boolean(emailError)}
+                errorMessage={emailError}
+                autoComplete="email"
+              />
+              <InputField
+                label="Job title"
+                value={values.jobTitle}
+                onChange={(jobTitle) => update({ jobTitle })}
+                description="Shown to teammates next to your name."
+                autoComplete="organization-title"
+              />
+            </Flex>
+
+            <Flex direction="column" gap="400">
+              <TextHeading elementType="h2">Notifications</TextHeading>
+              <SwitchGroup>
+                <SwitchField
+                  label="Product updates"
+                  description="News about features and improvements."
+                  isSelected={values.productUpdates}
+                  onChange={(productUpdates) => update({ productUpdates })}
+                />
+                <SwitchField
+                  label="Weekly digest"
+                  description="A summary of team activity every Monday."
+                  isSelected={values.weeklyDigest}
+                  onChange={(weeklyDigest) => update({ weeklyDigest })}
+                />
+                <SwitchField
+                  label="Security alerts"
+                  description="Always on to keep your account safe."
+                  isSelected
+                  isDisabled
+                />
+              </SwitchGroup>
+            </Flex>
+
+            <Flex direction="column" gap="400">
+              <TextHeading elementType="h2">Team members</TextHeading>
+              <Flex direction="column" gap="600" role="list" aria-label="Team members">
+                {values.members.map((member) => {
+                  const isOwner = member.role === "Owner";
+                  return (
+                    <Flex
+                      key={member.id}
+                      role="listitem"
+                      direction={isMobile ? "column" : "row"}
+                      alignPrimary="space-between"
+                      alignSecondary={isMobile ? "stretch" : "center"}
+                      gap="400"
+                    >
+                      <AvatarBlock title={member.name} description={member.email}>
+                        <Avatar initials={initials(member.name)} />
+                      </AvatarBlock>
+                      <Flex gap="400" alignSecondary="end">
+                        <FlexItem size={isMobile ? "fill" : undefined}>
+                          <SelectField
+                            label="Role"
+                            aria-label={`Role for ${member.name}`}
+                            selectedKey={member.role}
+                            onSelectionChange={(key) => key && updateMember(member.id, key as Role)}
+                            isDisabled={isOwner}
+                            disabledKeys={isOwner ? [] : ["Owner"]}
+                            description={isOwner ? "The owner's role can't be changed." : undefined}
+                          >
+                            {ROLES.map((role) => (
+                              <SelectItem key={role} id={role}>
+                                {role}
+                              </SelectItem>
+                            ))}
+                          </SelectField>
+                        </FlexItem>
+                        <ButtonDanger
+                          variant="danger-subtle"
+                          aria-label={`Remove ${member.name}`}
+                          isDisabled={isOwner}
+                          onPress={() => removeMember(member.id)}
+                        >
+                          Remove
+                        </ButtonDanger>
+                      </Flex>
+                    </Flex>
+                  );
+                })}
+              </Flex>
+            </Flex>
+
+            <ButtonGroup align={isMobile ? "stack" : "end"}>
+              <Button type="button" variant="neutral" onPress={onCancel}>
+                Cancel
+              </Button>
+              <Button type="submit" isDisabled={!isDirty || isInvalid}>
+                Save changes
+              </Button>
+            </ButtonGroup>
+          </Flex>
+        </Form>
+      </Flex>
+    </Section>
+  );
+}
